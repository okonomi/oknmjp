---
import { getCollection, type CollectionEntry } from "astro:content"
import { Image } from "astro:assets"

import { SITE_TITLE } from "@/config"
import Layout from "@/layouts/Blog.astro"
import FormattedDate from "@/components/FormattedDate.astro"

export async function getStaticPaths() {
  const posts = await getCollection("posts")
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }))
}

type Props = CollectionEntry<"posts">

const post = Astro.props
const { Content } = await post.render()
// const { title, description, pubDate, updatedDate, heroImage } = post.data
const title = `${post.data.title} | ${SITE_TITLE}`
if (
  post.data.heroImage &&
  post.data.heroImage.startsWith("http") &&
  (!post.data.heroImageWidth || !post.data.heroImageHeight)
) {
  throw new Error("Remote hero images require heroImageWidth and heroImageHeight.")
}
type HeroImageProps =
  | { width: number; height: number; inferSize?: false }
  | { inferSize: true }

const heroImageProps: HeroImageProps | undefined =
  post.data.heroImageWidth && post.data.heroImageHeight
    ? { width: post.data.heroImageWidth, height: post.data.heroImageHeight }
    : post.data.heroImage && !post.data.heroImage.startsWith("http")
        ? { inferSize: true as const }
        : undefined
---

<Layout title={title} description={post.data.description ?? ""} pageType="article">
  <article class="prose lg:prose-lg prose-img:rounded-lg prose-ul:m-0 prose-li:m-0 mx-auto">
    {
      post.data.heroImage && (
        <div class="not-prose mb-8">
          <div class="not-prose mb-8">
            <Image
              src={post.data.heroImage}
              alt=""
              {...(heroImageProps ?? { inferSize: true as const })}
              class="aspect-video object-cover object-center rounded-lg"
              priority
            />
          </div>
        </div>
      )
    }

    <div class="text-sm text-gray-600">
      <FormattedDate date={post.data.pubDate} />
    </div>
    <h1>{post.data.title}</h1>

    <Content />
  </article>
</Layout>
